- insert:
    - id: mcp-zhenzhen-nanobanana
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: zhenzhen-nanobanana-mcp
        command: uv
        args:
          - --directory
          - 'D:\MCP\zhenzhen-nanobanana-mcp'
          - run
          - --no-sync
          - python
          - -m
          - zhenzhen_nanobanana_mcp
        toolCallTimeoutMs: 1800000
        failOnStartupError: true
        reconnect:
          enabled: false
