{
  "tools": [
    {
      "name": "list_models",
      "title": "List Models",
      "description": "列出七个模型（含 2k/4k 变体）、API 格式、访问目录与限制；不联网、不返回密钥。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "execution": null,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "api_formats": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default_model": {
            "type": "string"
          },
          "default_api_format": {
            "type": "string"
          },
          "max_batch_items": {
            "type": "integer"
          },
          "max_reference_images": {
            "type": "integer"
          },
          "concurrency_per_process": {
            "description": "兼容字段：本机配置上限；实际按共享输出目录的SQLite账本限制并发。",
            "type": "integer"
          },
          "concurrency_scope": {
            "const": "shared_output_directory",
            "default": "shared_output_directory",
            "type": "string"
          },
          "input_dirs": {
            "description": "兼容字段，始终为空列表，表示没有目录白名单。",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "local_file_access": {
            "const": "readable_files",
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "api_key_configured": {
            "type": "boolean"
          },
          "upstream_verified": {
            "default": false,
            "type": "boolean"
          },
          "capabilities": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "supported_endpoints": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "async_tasks": {
            "default": true,
            "type": "boolean"
          },
          "max_pending_tasks": {
            "default": 200,
            "type": "integer"
          },
          "reference_input_note": {
            "default": "Gemini/Chat多模态和Generations参考图编码未在本次收费实测；nano-banana-pro仅DALL·E，Edits重复image字段。",
            "type": "string"
          }
        },
        "required": [
          "models",
          "api_formats",
          "default_model",
          "default_api_format",
          "max_batch_items",
          "max_reference_images",
          "concurrency_per_process",
          "input_dirs",
          "local_file_access",
          "output_dir",
          "api_key_configured"
        ],
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": null,
        "readOnlyHint": true,
        "destructiveHint": null,
        "idempotentHint": null,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
