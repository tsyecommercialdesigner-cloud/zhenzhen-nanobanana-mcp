    {
      "name": "plan_ecommerce_images",
      "title": "Plan Ecommerce Images",
      "description": "免费生成可审阅的主图/详情页/场景/海报绘图计划。\n\nscene: main 主图；detail 详情模块；scene 家居场景；poster 营销海报。\nselling_points: 已核实事实，可为空列表；不自动编造商品信息。\ncount: 图片项数，详情页推荐 6 项；比例由用户决定。\nreference_images: 原样传入计划，真正出图前才读取/下载并校验。\nresolution: 可选显式 width/height 像素尺寸，原样传入每项用于模型路由。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "selling_points": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "scene": {
            "default": "main",
            "enum": [
              "main",
              "detail",
              "scene",
              "poster"
            ],
            "type": "string"
          },
          "count": {
            "default": 1,
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "aspect_ratio": {
            "default": "1:1",
            "enum": [
              "4:3",
              "3:4",
              "16:9",
              "9:16",
              "2:3",
              "3:2",
              "1:1",
              "4:5",
              "5:4",
              "21:9"
            ],
            "type": "string"
          },
          "reference_images": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "requirements": {
            "default": "",
            "maxLength": 2000,
            "type": "string"
          },
          "copy_text": {
            "default": "",
            "maxLength": 1000,
            "type": "string"
          },
          "resolution": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "description": "用户显式指定的宽度，单位 px。",
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  },
                  "height": {
                    "description": "用户显式指定的高度，单位 px。",
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "product_name",
          "selling_points"
        ]
      },
      "execution": null,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "product_name": {
            "type": "string"
          },
          "scene": {
            "enum": [
              "main",
              "detail",
              "scene",
              "poster"
            ],
            "type": "string"
          },
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "description": "完整绘图/修改提示词；不自动添加平台要求。",
                  "maxLength": 8000,
                  "minLength": 1,
                  "type": "string"
                },
                "aspect_ratio": {
                  "default": "1:1",
                  "enum": [
                    "4:3",
                    "3:4",
                    "16:9",
                    "9:16",
                    "2:3",
                    "3:2",
                    "1:1",
                    "4:5",
                    "5:4",
                    "21:9"
                  ],
                  "type": "string"
                },
                "resolution": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "width": {
                          "description": "用户显式指定的宽度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        },
                        "height": {
                          "description": "用户显式指定的高度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "width",
                        "height"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "显式像素尺寸，仅按长边选择模型：≤1024 原版，≤2048 2k，否则 4k；不改变比例或保证输出尺寸。"
                },
                "reference_images": {
                  "description": "本机可读取图片的绝对路径或公开 HTTP/HTTPS 图片 URL，不限制文件目录，无需搬到 input。有参考图即编辑。",
                  "items": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "prompt"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "product_name",
          "scene",
          "items",
          "notes"
        ],
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": null,
        "readOnlyHint": true,
        "destructiveHint": null,
        "idempotentHint": null,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "submit_image_tasks",
      "title": "Submit Image Tasks",
      "description": "批量登记1–12个后台图像任务并立即返回，不等待绘图/下载（会在后台收费）。\n\n每项task_id在checkpointer/thread_id内唯一且稳定，同内容复用；任何冲突全批不新增。\n每项可选model/api_format(auto)/endpoint(auto)；变体按显式resolution路由。\nFlash-lite仅Gemini/Chat；nano-banana-pro仅DALL·E；gemini-nano仅DALL·E Generations/Gemini/Chat。\n查询get_image_tasks；queued/preparing/running是正常状态，unknown不能盲目重交。\nMCP进程关闭时未发送任务可在重启后继续，已可能发送任务不自动重试。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checkpointer": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "type": "string"
          },
          "thread_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "type": "string"
          },
          "tasks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "description": "完整绘图/修改提示词；不自动添加平台要求。",
                  "maxLength": 8000,
                  "minLength": 1,
                  "type": "string"
                },
                "aspect_ratio": {
                  "default": "1:1",
                  "enum": [
                    "4:3",
                    "3:4",
                    "16:9",
                    "9:16",
                    "2:3",
                    "3:2",
                    "1:1",
                    "4:5",
                    "5:4",
                    "21:9"
                  ],
                  "type": "string"
                },
                "resolution": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "width": {
                          "description": "用户显式指定的宽度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        },
                        "height": {
                          "description": "用户显式指定的高度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "width",
                        "height"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "显式像素尺寸，仅按长边选择模型：≤1024 原版，≤2048 2k，否则 4k；不改变比例或保证输出尺寸。"
                },
                "reference_images": {
                  "description": "本机可读取图片的绝对路径或公开 HTTP/HTTPS 图片 URL，不限制文件目录，无需搬到 input。有参考图即编辑。",
                  "items": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 4,
                  "type": "array"
                },
                "task_id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                  "type": "string"
                },
                "model": {
                  "default": "gemini-nano-banana-2.1",
                  "enum": [
                    "gemini-3.1-flash-lite-image",
                    "nano-banana-pro",
                    "gemini-nano-banana-2.1",
                    "gemini-nano-banana-2.1-2k",
                    "gemini-nano-banana-2.1-4k",
                    "nano-banana-pro-2k",
                    "nano-banana-pro-4k"
                  ],
                  "type": "string"
                },
                "api_format": {
                  "default": "auto",
                  "enum": [
                    "auto",
                    "dalle",
                    "chat",
                    "gemini"
                  ],
                  "type": "string"
                },
                "endpoint": {
                  "default": "auto",
                  "enum": [
                    "auto",
                    "generations",
                    "edits"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "prompt",
                "task_id"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "checkpointer",
          "thread_id",
          "tasks"
        ]
      },
      "execution": null,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "checkpointer": {
            "title": "Checkpointer",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "tasks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "checkpointer": {
                  "title": "Checkpointer",
                  "type": "string"
                },
                "thread_id": {
                  "title": "Thread Id",
                  "type": "string"
                },
                "task_id": {
                  "title": "Task Id",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "queued",
                    "preparing",
                    "running",
                    "succeeded",
                    "failed",
                    "unknown",
                    "cancelled"
                  ],
                  "title": "Status",
                  "type": "string"
                },
                "actual_model": {
                  "enum": [
                    "gemini-3.1-flash-lite-image",
                    "nano-banana-pro",
                    "gemini-nano-banana-2.1",
                    "gemini-nano-banana-2.1-2k",
                    "gemini-nano-banana-2.1-4k",
                    "nano-banana-pro-2k",
                    "nano-banana-pro-4k"
                  ],
                  "title": "Actual Model",
                  "type": "string"
                },
                "api_format": {
                  "enum": [
                    "dalle",
                    "chat",
                    "gemini"
                  ],
                  "title": "Api Format",
                  "type": "string"
                },
                "endpoint": {
                  "title": "Endpoint",
                  "type": "string"
                },
                "images": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "title": "Path",
                        "type": "string"
                      },
                      "mime_type": {
                        "title": "Mime Type",
                        "type": "string"
                      },
                      "width": {
                        "title": "Width",
                        "type": "integer"
                      },
                      "height": {
                        "title": "Height",
                        "type": "integer"
                      },
                      "bytes": {
                        "title": "Bytes",
                        "type": "integer"
                      },
                      "sha256": {
                        "title": "Sha256",
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "mime_type",
                      "width",
                      "height",
                      "bytes",
                      "sha256"
                    ],
                    "title": "SavedImage",
                    "type": "object"
                  },
                  "title": "Images",
                  "type": "array"
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Error"
                },
                "created_at": {
                  "title": "Created At",
                  "type": "number"
                },
                "updated_at": {
                  "title": "Updated At",
                  "type": "number"
                },
                "reused": {
                  "default": false,
                  "title": "Reused",
                  "type": "boolean"
                }
              },
              "required": [
                "checkpointer",
                "thread_id",
                "task_id",
                "status",
                "actual_model",
                "api_format",
                "endpoint",
                "created_at",
                "updated_at"
              ],
              "title": "TaskResult",
              "type": "object"
            },
            "title": "Tasks",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Cursor"
          }
        },
        "required": [
          "checkpointer",
          "thread_id",
          "tasks"
        ],
        "title": "TaskPage",
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": null,
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
