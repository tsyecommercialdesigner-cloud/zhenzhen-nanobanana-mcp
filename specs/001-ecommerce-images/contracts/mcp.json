{
  "tools": [
    {
      "name": "list_models",
      "title": "List Models",
      "description": "列出七个模型（含 2k/4k 变体）、API 格式、访问目录与限制；不联网、不返回密钥。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "execution": null,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "api_formats": {
            "items": {
