            },
            "type": "array"
          },
          "default_model": {
            "type": "string"
          },
          "default_api_format": {
            "type": "string"
          },
          "max_batch_items": {
            "type": "integer"
          },
          "max_reference_images": {
            "type": "integer"
          },
          "concurrency_per_process": {
            "type": "integer"
          },
          "input_dirs": {
            "description": "兼容字段，始终为空列表，表示没有目录白名单。",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "local_file_access": {
