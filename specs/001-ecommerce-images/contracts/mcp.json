    {
      "name": "generate_images",
      "title": "Generate Images",
      "description": "提交 1–12 项独立绘图请求（收费），自动保存图片并返回绝对路径。\n\nrequest_id: 1–64 位字母/数字/下划线/连字符，必须为本次业务稳定且唯一的编号。\nitems: 每项一个提示词及比例；参考图非空执行编辑，否则文生图。\nmodel: 七个模型均支持生成及编辑；default 不代表质量排名。\nitems.resolution: 显式 width/height；长边≤1024 用原版，1024<长边≤2048 用2k，>2048 用4k。\nflash-lite 不路由；未指定尺寸保留所选模型；actual_model 返回每项实际模型。\napi_format: 默认 dalle；chat/gemini 映射尚未做真实上游联调。\n同编号同参数复用持久结果；冲突/中断不重发；部分失败 isError 为 true。\n一项可能返回多张图片（最多 4 张）。无收费 POST 重试。Host 超时建议 1800 秒。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "description": "完整绘图/修改提示词；不自动添加平台要求。",
                  "maxLength": 8000,
                  "minLength": 1,
                  "type": "string"
                },
                "aspect_ratio": {
                  "default": "1:1",
                  "enum": [
                    "4:3",
                    "3:4",
                    "16:9",
                    "9:16",
                    "2:3",
                    "3:2",
                    "1:1",
                    "4:5",
                    "5:4",
                    "21:9"
                  ],
                  "type": "string"
                },
                "resolution": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "width": {
                          "description": "用户显式指定的宽度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        },
                        "height": {
                          "description": "用户显式指定的高度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "width",
                        "height"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "显式像素尺寸，仅按长边选择模型：≤1024 原版，≤2048 2k，否则 4k；不改变比例或保证输出尺寸。"
                },
                "reference_images": {
                  "description": "本机可读取图片的绝对路径或公开 HTTP/HTTPS 图片 URL，不限制文件目录，无需搬到 input。有参考图即编辑。",
                  "items": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "prompt"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array"
          },
          "model": {
            "default": "gemini-nano-banana-2.1",
            "enum": [
              "gemini-3.1-flash-lite-image",
              "nano-banana-pro",
              "gemini-nano-banana-2.1",
              "gemini-nano-banana-2.1-2k",
              "gemini-nano-banana-2.1-4k",
              "nano-banana-pro-2k",
              "nano-banana-pro-4k"
            ],
            "type": "string"
          },
          "api_format": {
            "default": "dalle",
            "enum": [
              "dalle",
              "chat",
              "gemini"
            ],
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "items"
        ]
      },
      "execution": null,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "batch_id": {
            "title": "Batch Id",
            "type": "string"
          },
          "model": {
            "enum": [
              "gemini-3.1-flash-lite-image",
              "nano-banana-pro",
              "gemini-nano-banana-2.1",
              "gemini-nano-banana-2.1-2k",
              "gemini-nano-banana-2.1-4k",
              "nano-banana-pro-2k",
              "nano-banana-pro-4k"
            ],
            "title": "Model",
            "type": "string"
          },
          "api_format": {
            "enum": [
              "dalle",
              "chat",
              "gemini"
            ],
            "title": "Api Format",
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "succeeded",
              "partial",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "index": {
                  "title": "Index",
                  "type": "integer"
                },
                "operation": {
                  "enum": [
                    "generate",
                    "edit"
                  ],
                  "title": "Operation",
                  "type": "string"
                },
                "actual_model": {
                  "anyOf": [
                    {
                      "enum": [
                        "gemini-3.1-flash-lite-image",
                        "nano-banana-pro",
                        "gemini-nano-banana-2.1",
                        "gemini-nano-banana-2.1-2k",
                        "gemini-nano-banana-2.1-4k",
                        "nano-banana-pro-2k",
                        "nano-banana-pro-4k"
                      ],
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "本项路由后的实际模型；旧记录查询时补齐。",
                  "title": "Actual Model"
                },
                "status": {
                  "default": "pending",
                  "enum": [
                    "pending",
                    "running",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ],
                  "title": "Status",
                  "type": "string"
                },
                "images": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "title": "Path",
                        "type": "string"
                      },
                      "mime_type": {
                        "title": "Mime Type",
                        "type": "string"
                      },
                      "width": {
                        "title": "Width",
                        "type": "integer"
                      },
                      "height": {
                        "title": "Height",
                        "type": "integer"
                      },
                      "bytes": {
                        "title": "Bytes",
                        "type": "integer"
                      },
                      "sha256": {
                        "title": "Sha256",
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "mime_type",
                      "width",
                      "height",
                      "bytes",
                      "sha256"
                    ],
                    "title": "SavedImage",
                    "type": "object"
                  },
                  "title": "Images",
                  "type": "array"
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Error"
                }
              },
              "required": [
                "index",
                "operation"
              ],
              "title": "ItemResult",
              "type": "object"
            },
            "title": "Items",
            "type": "array"
          },
          "manifest_path": {
            "title": "Manifest Path",
            "type": "string"
          },
          "reused": {
            "default": false,
            "title": "Reused",
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Warning"
          }
        },
        "required": [
          "request_id",
          "batch_id",
          "model",
          "api_format",
          "status",
          "items",
          "manifest_path"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": null,
        "readOnlyHint": false,
