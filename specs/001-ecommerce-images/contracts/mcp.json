    {
      "name": "plan_ecommerce_images",
      "title": "Plan Ecommerce Images",
      "description": "免费生成可审阅的主图/详情页/场景/海报绘图计划。\n\nscene: main 主图；detail 详情模块；scene 家居场景；poster 营销海报。\nselling_points: 已核实事实，可为空列表；不自动编造商品信息。\ncount: 图片项数，详情页推荐 6 项；比例由用户决定。\nreference_images: 原样传入计划，真正出图前才读取/下载并校验。\nresolution: 可选显式 width/height 像素尺寸，原样传入每项用于模型路由。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "selling_points": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "scene": {
            "default": "main",
            "enum": [
              "main",
              "detail",
              "scene",
              "poster"
            ],
            "type": "string"
          },
          "count": {
            "default": 1,
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "aspect_ratio": {
            "default": "1:1",
            "enum": [
              "4:3",
              "3:4",
              "16:9",
              "9:16",
              "2:3",
              "3:2",
              "1:1",
              "4:5",
              "5:4",
              "21:9"
            ],
            "type": "string"
          },
          "reference_images": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "requirements": {
            "default": "",
            "maxLength": 2000,
            "type": "string"
          },
          "copy_text": {
            "default": "",
            "maxLength": 1000,
            "type": "string"
          },
          "resolution": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "description": "用户显式指定的宽度，单位 px。",
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  },
                  "height": {
                    "description": "用户显式指定的高度，单位 px。",
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "product_name",
          "selling_points"
        ]
      },
      "execution": null,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "product_name": {
            "type": "string"
          },
          "scene": {
            "enum": [
              "main",
              "detail",
              "scene",
              "poster"
            ],
            "type": "string"
          },
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "description": "完整绘图/修改提示词；不自动添加平台要求。",
                  "maxLength": 8000,
                  "minLength": 1,
                  "type": "string"
                },
                "aspect_ratio": {
                  "default": "1:1",
                  "enum": [
                    "4:3",
                    "3:4",
                    "16:9",
                    "9:16",
                    "2:3",
                    "3:2",
                    "1:1",
                    "4:5",
                    "5:4",
                    "21:9"
                  ],
                  "type": "string"
                },
                "resolution": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "width": {
                          "description": "用户显式指定的宽度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        },
                        "height": {
                          "description": "用户显式指定的高度，单位 px。",
                          "exclusiveMinimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "width",
                        "height"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "显式像素尺寸，仅按长边选择模型：≤1024 原版，≤2048 2k，否则 4k；不改变比例或保证输出尺寸。"
                },
                "reference_images": {
                  "description": "本机可读取图片的绝对路径或公开 HTTP/HTTPS 图片 URL，不限制文件目录，无需搬到 input。有参考图即编辑。",
                  "items": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "prompt"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "product_name",
          "scene",
          "items",
          "notes"
        ],
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": null,
        "readOnlyHint": true,
        "destructiveHint": null,
        "idempotentHint": null,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
